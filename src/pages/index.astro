---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import Socials from "../components/Socials.astro";
---

<Layout title="Luca Cotti">
  <header class="w-screen h-screen flex">
    <div class="flex flex-col items-center gap-4 m-auto">
      <Avatar />

      <h1 class="mt-2 mb-2">Luca Cotti</h1>

      <h2 class="mt-0 mb-2">AI Engineer & Researcher</h2>

      <Socials />
    </div>
  </header>
  <main id="main"></main>
</Layout>
