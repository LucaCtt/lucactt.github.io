---
import {
  GOOGLE_VERIFICATION,
  EMAIL,
  LINKEDIN,
  GITHUB,
  ORCID,
} from "astro:env/client";

import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import Socials from "../components/Socials.astro";
import Publications from "../components/Publications.astro";

import avatarImage from "../assets/avatar.png";
---

<Layout title="Luca Cotti" googleVerification={GOOGLE_VERIFICATION}>
  <main id="main" class="flex flex-col items-center justify-center-safe">
    <section class="flex flex-col items-center gap-4">
      <div class="flex flex-col items-center gap-2">
        <Avatar src={avatarImage} />
        <h1 class="mt-2 mb-2">Luca Cotti</h1>
        <span class="mt-0 mb-2 text-lg">AI Engineer & Researcher</span>
      </div>

      <Socials
        email={EMAIL}
        linkedin={LINKEDIN}
        github={GITHUB}
        orcid={ORCID}
      />
    </section>

    <section>
      <h2>Recent Publications</h2>
      <Publications orcid={ORCID} userEmail={EMAIL} />
    </section>
  </main>
</Layout>
