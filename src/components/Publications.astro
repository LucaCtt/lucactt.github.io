---
import { fetchPublications } from "../utils/publications";

const initialPublications = await fetchPublications();
---

<>
    {initialPublications.length === 0 && <p>No publications found.</p>}
    <ul id="orcid-list" class="p-0 list-none">
        {
            initialPublications.map((pub) => (
                <li class="mb-1">
                    <a href={pub.url} target="_blank" rel="noopener noreferrer">
                        {pub.title}
                    </a>
                    {pub.journal && (
                        <span class="italic opacity-80"> — {pub.journal}</span>
                    )}
                    {pub.year && <span class="opacity-60"> ({pub.year})</span>}
                </li>
            ))
        }
    </ul>
</>

<script>
    import { fetchPublications } from "../utils/publications";

    async function updatePublications() {
        const topWorks = await fetchPublications();
        if (topWorks.length === 0) return;

        const list = document.getElementById("orcid-list");
        const emptyMsg = document.getElementById("orcid-empty");

        if (emptyMsg) emptyMsg.remove();
        if (!list) return;

        list.innerHTML = topWorks
            .map(
                (pub) => `
        <li class="mb-1">
          <a href="${pub.url}" target="_blank" rel="noopener noreferrer">
            ${pub.title}
          </a>
          ${pub.journal ? `<span class="italic opacity-80"> — ${pub.journal}</span>` : ""}
          ${pub.year ? `<span class="opacity-60"> (${pub.year})</span>` : ""}
        </li>
      `,
            )
            .join("");
    }

    updatePublications();
</script>
