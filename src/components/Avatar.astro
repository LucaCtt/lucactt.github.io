---
import { Image } from "astro:assets";
import avatarImage from "../assets/avatar.png";
---

<div
  class="w-40 h-40 rounded-full bg-black flex justify-center items-center overflow-hidden"
>
  <Image
    src={avatarImage}
    priority
    alt="Avatar"
    class="w-full h-full object-cover text-black"
  />
</div>
