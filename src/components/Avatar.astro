---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
}

const { src } = Astro.props;
---

<div
  class="avatar flex h-36 w-36 cursor-pointer items-center justify-center overflow-hidden rounded-full bg-black"
>
  <Image
    src={src}
    priority
    alt="Avatar"
    class="h-full w-full object-cover text-black"
  />
</div>

<script>
  import { makeElastic } from "../utils/elastic";

  document
    .querySelectorAll<HTMLAnchorElement>(".avatar")
    .forEach((el) => makeElastic(el, { draggable: false, maxDrag: 16 } as any));
</script>
